# ---------------------------------------------------------------------------
# fantasy-football-prediction-model - example environment file
#
# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   WSL / Linux / macOS: cp .env.example .env
#
# Every variable below is OPTIONAL. The veteran projection pipeline runs with
# no environment configuration at all.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CollegeFootballData (https://collegefootballdata.com/)
#
# Free API key, used ONLY to enrich rookie projections with college production.
# Without it the rookie pipeline runs in "reduced" mode using nflverse draft,
# combine, roster and depth-chart data, and rookie confidence is lowered.
#
# SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_ and never add it to
# Vercel: the web application never talks to CollegeFootballData.
# ---------------------------------------------------------------------------
CFBD_API_KEY=

# ---------------------------------------------------------------------------
# Python pipeline
# ---------------------------------------------------------------------------

# Root directory for raw/cache/interim/processed data. Relative to repo root.
FFPM_DATA_DIR=./data

# HTTP + parquet cache directory.
FFPM_CACHE_DIR=./data/cache

# Season the pipeline projects. Overrides configs/project.yml when set.
FFPM_TARGET_SEASON=2026

# When true, the pipeline refuses to make network calls and uses only the
# local cache. Fails loudly if a required dataset is not cached.
FFPM_OFFLINE=false

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
FFPM_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Next.js web application
#
# Only NEXT_PUBLIC_* variables reach the browser bundle. Keep it that way.
# ---------------------------------------------------------------------------

# Absolute site URL, used for canonical links, sitemap and Open Graph tags.
# Local: http://localhost:3000
# Production: https://<your-project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public browser values from Supabase Project Settings → API. These are safe to
# expose; authorization is enforced by RLS. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
