# ---------------------------------------------------------------------------
# Data: raw and cached downloads are NEVER committed.
# They are large, redistributable-with-conditions, and fully reproducible.
# See data/README.md for the full policy.
# ---------------------------------------------------------------------------
data/raw/**
!data/raw/.gitkeep
data/cache/**
!data/cache/.gitkeep
data/interim/**
!data/interim/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Personal (non-example) manual override files
data/manual/player-context.csv
data/manual/projection-overrides.csv

# ---------------------------------------------------------------------------
# Artifacts: model binaries are not committed; small reports are.
# ---------------------------------------------------------------------------
artifacts/models/**
!artifacts/models/.gitkeep
artifacts/evaluations/*.parquet
artifacts/projections/*.parquet
artifacts/logs/

